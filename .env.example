PROJECT_NAME=financial-api
VERSION=1.0.0
API_V1_PREFIX=/api/v1
DEBUG=False
DEMO=True
PROD=False

# Port of the postgres you run the API against locally (outside docker).
DB_PORT=5432
# Host port docker compose publishes its own postgres on.
DB_HOST_PORT=5432

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

USERNAME_API=api_users
USERNAME_PASSWORD=123

# No database name here: app/core/database.py appends it (demo_db_v1 under
# DEMO, financial_api_V1 otherwise). docker compose overrides the host with `db`.
DATABASE_URL=postgresql+psycopg2://${USERNAME_API}:${USERNAME_PASSWORD}@localhost:${DB_PORT}
MIGRATION_DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${DB_PORT}
